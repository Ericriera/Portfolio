---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import logo from "@/assets/logo.png";
---

<header
  class="bg-neutral-800/40 backdrop-blur-md border border-white/10 flex flex-col md:flex-row items-center md:justify-between px-4 py-2 rounded-4xl shadow-md fixed top-4 md:top-6 left-1/2 transform -translate-x-1/2 w-11/12 md:w-auto md:max-w-screen-md md:px-8 z-50 transition-all duration-300"
>
  <!-- Logo + botón -->
  <div class="w-full flex items-center justify-between">
    <a href="#" class="flex-shrink-0">
      <Image
        src={logo}
        alt="Eric Riera logo"
        class="h-10 w-auto mr-4 md:mr-8"
        widths={[96, 192]}
        sizes="96px"
        format="webp"
        loading="eager"
      />
    </a>

    <!-- Botón hamburguesa -->
    <button
      id="menu-toggle"
      class="interactive-press md:hidden text-white text-2xl"
      aria-label="Toggle menu"
      aria-controls="mobile-menu"
      aria-expanded="false"
      type="button"
    >
      <Icon name="fa6-solid:bars" size="24" />
      <Icon class="hidden" name="fa6-solid:xmark" size="24" />
    </button>
  </div>

  <!-- Navigation menu -->
  <nav
    id="mobile-menu"
    class="mobile-nav md:flex md:items-center md:gap-8 md:mb-0"
    data-open="false"
  >
    <a
      class="text-white hover:text-cornflower transition-all duration-300 font-medium whitespace-nowrap"
      href="#aboutme"
    >
      About me
    </a>
    <a
      class="text-white hover:text-cornflower transition-all duration-300 font-medium whitespace-nowrap"
      href="#timeline"
    >
      Timeline
    </a>
    <a
      class="text-white hover:text-cornflower transition-all duration-300 font-medium whitespace-nowrap"
      href="#projects"
    >
      Projects
    </a>
  </nav>
</header>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const toggleBtn = document.getElementById("menu-toggle");
    const menu = document.getElementById("mobile-menu");
    if (!toggleBtn || !menu) return;

    const icons = toggleBtn.querySelectorAll("svg");
    const links = menu.querySelectorAll("a");

    const setMenuState = (isOpen) => {
      menu.dataset.open = String(isOpen);
      toggleBtn.setAttribute("aria-expanded", String(isOpen));

      if (icons[0] && icons[1]) {
        icons[0].classList.toggle("hidden", isOpen);
        icons[1].classList.toggle("hidden", !isOpen);
      }
    };

    toggleBtn.addEventListener("click", () => {
      const isOpen = menu.dataset.open === "true";
      setMenuState(!isOpen);
    });

    links.forEach((link) => {
      link.addEventListener("click", () => {
        if (window.innerWidth < 768) {
          setMenuState(false);
        }
      });
    });

    window.addEventListener("resize", () => {
      if (window.innerWidth >= 768) {
        setMenuState(false);
      }
    });
  });
</script>

<style>
  @media (max-width: 767px) {
    .mobile-nav {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      max-height: 0;
      opacity: 0;
      overflow: hidden;
      pointer-events: none;
      transform: translateY(-0.75rem) scale(0.98);
      transition:
        max-height 360ms var(--ease-snappy),
        opacity 220ms ease,
        transform 360ms var(--ease-snappy),
        margin-top 360ms var(--ease-snappy);
    }

    .mobile-nav[data-open="true"] {
      max-height: 14rem;
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0) scale(1);
      margin-top: 1rem;
      padding-bottom: 0.25rem;
    }
  }

  @media (min-width: 768px) {
    .mobile-nav {
      display: flex !important;
      opacity: 1 !important;
      transform: none !important;
      max-height: none !important;
      pointer-events: auto !important;
      overflow: visible !important;
    }
  }
</style>
